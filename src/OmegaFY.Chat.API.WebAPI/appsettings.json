{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "Sqlite": "[SECRET]"
  },
  "JwtSettings": {
    "Audience": "[SECRET]",
    "Issuer": "[SECRET]",
    "Secret": "[SECRET]",
    "TimeToExpireToken": "[SECRET]",
    "TimeToExpireRefreshToken": "[SECRET]"
  },
  "AuthenticationSettings": {
    "PasswordRequireDigit": true,
    "PasswordRequireLowercase": true,
    "PasswordRequireNonAlphanumeric": true,
    "PasswordRequireUppercase": true,
    "PasswordMinRequiredLength": 10,
    "PasswordMaxRequiredLength": 64,
    "PasswordRequiredUniqueChars": 5,
    "DefaultLockoutTimeSpan": "00:03:00",
    "MaxFailedAccessAttempts": 3,
    "RequireUniqueEmail": true,
    "RequireConfirmedEmail": false,
    "RequireConfirmedAccount": false
  },
  "AllowedHosts": "*",
  "OpenTelemetrySettings": {
    "ServiceName": "[SECRET]",
    "HoneycombSettings": {
      "HoneycombApiKey": "[SECRET]",
      "HoneycombUrl": "[SECRET]"
    }
  },
  "SendGridSettings": {
    "ApiKey": "[SECRET]",
    "FromEmail": "[SECRET]",
    "FromEmailDisplayName": "[SECRET]"
  },
  "IpOrUserTokenBucketPolicySettings": {
    "ReplenishmentPeriod": "00:01:00",
    "UserTokenLimit": "1000",
    "UserTokensPerPeriod": "100",
    "IpTokenLimit": "100",
    "IpTokensPerPeriod": "1"
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:5169", "https://localhost:7155", "http://localhost:4200" ],
    "AllowedMethods": [ "GET", "POST", "PUT", "DELETE", "OPTIONS" ],
    "AllowedHeaders": [ "Content-Type", "Authorization", "X-Requested-With", "Accept", "Origin", "Referer", "UserAgent" ]
  }
}